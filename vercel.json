{
  "version": 2,
  "buildCommand": "cd mathscore-backend && npx prisma generate && cd ../mathscore-frontend && npm install && VITE_API_URL=https://marvelous-nourishment-production-c87958d0.up.railway.app npm run build",
  "outputDirectory": "mathscore-frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://marvelous-nourishment-production-c87958d0.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://marvelous-nourishment-production-c87958d0.up.railway.app/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
