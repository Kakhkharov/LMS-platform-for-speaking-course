{
  "version": 2,
  "buildCommand": "cd mathscore-backend && npx prisma generate && cd ../mathscore-frontend && npm install && npm run build",
  "outputDirectory": "mathscore-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://marvelous-nourishment-production-c87958d0.up.railway.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://marvelous-nourishment-production-c87958d0.up.railway.app/uploads/$1"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
