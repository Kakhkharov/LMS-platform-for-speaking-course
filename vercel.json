{
  "version": 2,
  "buildCommand": "cd mathscore-backend && npx prisma generate && cd ../mathscore-frontend && npm install && npm run build",
  "outputDirectory": "mathscore-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
