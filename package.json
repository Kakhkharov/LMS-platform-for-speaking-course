    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
