{
  "name": "mathscore-loyiha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./run_all.ps1",
    "sync": "powershell -ExecutionPolicy Bypass -File ./sync.ps1",
    "postinstall": "cd mathscore-backend && npx prisma generate",
