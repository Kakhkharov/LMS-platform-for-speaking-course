  res.status(201).json(newCourse);
});

// Talaba tomonidan darsni tugatilgan deb belgilash funksiyasi
app.post('/api/lessons/:id/complete', authenticateToken, async (req, res) => {
  const lessonId = req.params.id;
  const userId = req.user.id;

  try {
    const existing = await prisma.completedLesson.findUnique({
      where: { userId_lessonId: { userId, lessonId } }
    });

    if (!existing) {
      await prisma.completedLesson.create({
        data: { userId, lessonId }
      });
    }

    res.json({ success: true, message: 'Dars muvaffaqiyatli yakunlandi!' });
  } catch (error) {
    res.status(500).json({ error: 'Dars holatini saqlashda xatolik yuz berdi.' });
  }
});`
  );

  // -------------------------------------------------------------
  // BO'LIM 5: MATEMATIK TESTLAR VA SAVOLLAR BAZASI
  // -------------------------------------------------------------
  addSection(
    "5. Matematik testlar, savollar banki va formulalarni shakllantirish moduli",
    "Ushbu modul matematika testlarini yaratish, ularga vaqt chegarasi (daqiqa), o‘tish foizi, qiyinlik darajasi hamda turli formatdagi savollarni (yagona tanlov, ko‘p tanlovli, rost/yolg‘on, qisqa yozma javoblar, matematik KaTeX formulalari) biriktirishni ta’minlaydi.",
    "server.js",
`// Yangi matematik test va savollarni saqlash funksiyasi
app.post('/api/tests', authenticateToken, requireRole('admin'), async (req, res) => {
  const {
    title,
    category,
    difficulty,
    questionCount,
    duration,
    status,
    passingPercentage,
    courseId,
    questions,
    startDate,
    endDate
  } = req.body;

  if (!title || !duration) {
    return res.status(400).json({ error: 'Test nomi va davomiyligi ko\\'rsatilishi shart.' });
  }

  const newTest = await db.create('tests', {
    title,
    category: category || 'Matematika',
    difficulty: difficulty || 'O\\'rta',
    questionCount: questions ? questions.length : Number(questionCount) || 0,
    duration: Number(duration),
    status: status || 'Faol',
    passingPercentage: Number(passingPercentage) || 70,
    courseId: courseId || null,
    startDate: startDate || null,
    endDate: endDate || null,
    questions: (questions || []).map((q, idx) => ({
      id: q.id || \`q_\${Date.now()}_\${idx}\`,
      type: q.type || 'single', // single, multiple, truefalse, short, math
      text: q.text,
      options: q.options || [],
      correctAnswer: q.correctAnswer,
      score: Number(q.score) || 1,
      explanation: q.explanation || '',
      hint: q.hint || '',
      imageUrl: q.imageUrl || null,
      markingScheme: q.markingScheme || null // AI baholash mezoni
    })),
    createdAt: new Date().toISOString()
  });

  res.status(201).json(newTest);
});`
  );

  // -------------------------------------------------------------
  // BO'LIM 6: SUN'IY INTELLEKT (GEMINI AI) YORDAMIDA SEMANTIK BAHOLASH
  // -------------------------------------------------------------
  addSection(
    "6. Sun’iy intellekt (Google Gemini AI) yordamida ochiq matematik javoblarni semantik baholash moduli",
    "Ushbu modul matematika bo‘yicha talaba tomonidan kiritilgan ochiq yozma javoblar va matematik isbotlarni Google Gemini generativ tili modeli yordamida chuqur semantik tahlil qiladi. Tizim javobni administrator tomonidan belgilangan baholash mezonlari (rubric), qabul qilinadigan muqobil usullar va odatiy adashishlar bilan solishtirib, qisman ball beradi, to‘g‘ri/noto‘g‘ri konseptlarni aniqlaydi va talaba uchun yo‘naltiruvchi tushuntirish hosil qiladi.",
    "geminiGrader.js",
`const GEMINI_API_URL = 'https://generativelanguage.googleapis.com/v1beta/models';

/**
 * Gemini AI yordamida ochiq matematik savolni baholash funksiyasi
 */
async function gradeShortAnswerQuestion({
  questionId,
  questionText,
  maximumMarks = 1,
  studentAnswer = '',
  markingScheme = null
}) {
  const maxScore = Math.max(1, Math.round(Number(maximumMarks) || 1));
  const rawStudentText = String(studentAnswer || '').trim();

  // Agar talaba javob yozmagan bo'lsa
  if (!rawStudentText) {
    return {
      question_id: questionId,
      maximum_marks: maxScore,
      awarded_marks: 0,
      criterion_results: [],
      correct_concepts: [],
      missing_concepts: ["Javob yozilmadi"],
      incorrect_concepts: [],
      student_feedback: "Javob kiritilmadi.",
      grading_confidence: "high",
      grading_status: "graded"
    };
  }

  const apiKey = process.env.GEMINI_API_KEY;
  const modelName = process.env.GEMINI_GRADING_MODEL || 'gemini-1.5-flash';

  const systemInstruction = 
    "Siz matematika fanidan qat'iy va adolatli xalqaro imtihon baholovchi mutaxassissiz. " +
    "Talabaning yozma javobini mezonlar (rubric), to'g'ri tushunchalar va matematik qadamlar bo'yicha tahlil qiling. " +
    "Javobni quyidagi JSON formatida qaytaring: " +
    "{ awarded_marks: number, student_feedback: string, correct_concepts: string[], missing_concepts: string[] }";

  const userPrompt = JSON.stringify({
    savol_matni: questionText,
    maksimal_ball: maxScore,
    talaba_javobi: rawStudentText,
    namunaviy_javob: markingScheme?.modelAnswer || '',
    baholash_mezonlari: markingScheme?.criteria || [],
    qabul_qilinadigan_variantlar: markingScheme?.acceptedAlternatives || []
  });

  const response = await fetch(\`\${GEMINI_API_URL}/\${modelName}:generateContent?key=\${apiKey}\`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      contents: [{ role: 'user', parts: [{ text: userPrompt }] }],
      systemInstruction: { parts: [{ text: systemInstruction }] },
      generationConfig: {
        responseMimeType: 'application/json',
        temperature: 0.1
      }
    })
  });

  const data = await response.json();
  const evaluation = JSON.parse(data.candidates[0].content.parts[0].text);

  return {
    question_id: questionId,
    maximum_marks: maxScore,
    awarded_marks: Math.min(maxScore, Math.max(0, evaluation.awarded_marks || 0)),
    student_feedback: evaluation.student_feedback || '',
    correct_concepts: evaluation.correct_concepts || [],
    missing_concepts: evaluation.missing_concepts || [],
    grading_status: 'graded'
  };
}`
  );

  // -------------------------------------------------------------
  // BO'LIM 7: TEST TOPSHIRISH VA NATIJALARNI HISOBLASH
  // -------------------------------------------------------------
  addSection(
    "7. Test topshirish, avtomatlashtirilgan ball hisoblash va natijalarni umumlashtirish",
    "Ushbu funksiya o‘quvchi yuborgan barcha javoblarni (bir nechta variantli, ko‘p tanlovli, rost/yolg‘on va AI baholagan yozma javoblar) tekshiradi, umumiy to‘plangan ballni, to‘g‘ri/noto‘g‘ri javoblar sonini, o‘tish foizini hisoblaydi va natijani tizimga qayd etadi.",
    "server.js",
`app.post('/api/submissions', authenticateToken, async (req, res) => {
  const { testId, answers, tabSwitches, timeSpent } = req.body;
  const test = await db.getById('tests', testId);
  if (!test) return res.status(404).json({ error: 'Test topilmadi.' });

  let correctCount = 0;
  let totalPossibleScore = 0;
  let earnedScore = 0;
  const questionResults = [];
  const questions = test.questions || [];

  for (let idx = 0; idx < questions.length; idx++) {
    const q = questions[idx];
    const qScore = Math.max(1, Math.round(Number(q.score) || 1));
    totalPossibleScore += qScore;
    const studentAns = answers ? (answers[idx] ?? answers[q.id]) : undefined;

    let isCorrect = false;
    let awardedMarks = 0;
    let feedback = '';

    const qType = (q.type || 'single').toLowerCase();

    if (qType === 'single') {
      // Yagona to'g'ri variantli savol
      if (studentAns !== undefined && studentAns === q.correctAnswer) {
        isCorrect = true;
        awardedMarks = qScore;
        feedback = "To'g'ri javob!";
      } else {
        feedback = studentAns === undefined ? "Javob belgilanmadi." : "Noto'g'ri variant tanlandi.";
      }
    } else if (qType === 'multiple') {
      // Ko'p tanlovli variantlar
      const correctArr = Array.isArray(q.correctAnswer) ? q.correctAnswer : [];
      const studentArr = Array.isArray(studentAns) ? studentAns : [];
      if (correctArr.length === studentArr.length && correctArr.every(val => studentArr.includes(val))) {
        isCorrect = true;
        awardedMarks = qScore;
        feedback = "Barcha to'g'ri variantlar tanlandi!";
      } else {
        feedback = "Variantlar to'liq yoki to'g'ri tanlanmadi.";
      }
    } else if (qType === 'short') {
      // Sun'iy intellekt (Gemini AI) orqali semantik baholash
      const aiResult = await gradeShortAnswerQuestion({
        questionId: q.id,
        questionText: q.text,
        maximumMarks: qScore,
        studentAnswer: studentAns,
        markingScheme: q.markingScheme
      });
      awardedMarks = aiResult.awarded_marks;
      isCorrect = awardedMarks === qScore;
      feedback = aiResult.student_feedback;
    }

    if (isCorrect) correctCount++;
    earnedScore += awardedMarks;

    questionResults.push({
      questionId: q.id,
      questionText: q.text,
      studentAnswer: studentAns,
      correctAnswer: q.correctAnswer,
      isCorrect,
      score: awardedMarks,
      maxScore: qScore,
      feedback
    });
  }

  const finalPercentage = totalPossibleScore > 0 ? Math.round((earnedScore / totalPossibleScore) * 100) : 0;
  const passed = finalPercentage >= (test.passingPercentage || 70);

  const submission = await db.create('submissions', {
    userId: req.user.id,
    userName: req.user.name,
    userEmail: req.user.email,
    testId: test.id,
    testTitle: test.title,
    score: finalPercentage,
    earnedScore,
    totalPossibleScore,
    correctCount,
    incorrectCount: questions.length - correctCount,
    tabSwitches: Number(tabSwitches) || 0,
    timeSpent: timeSpent || '0:00',
    passed,
    details: JSON.stringify(questionResults),
    submittedAt: new Date().toISOString()
  });

  res.status(201).json(submission);
});`
  );

  // -------------------------------------------------------------
  // BO'LIM 8: PROKTORING VA ANTI-CHEAT NAZORATI
  // -------------------------------------------------------------
  addSection(
    "8. Imtihon davomida akademik halollikni ta’minlash va proktoring nazorati (Anti-cheating)",
    "Ushbu funksiyalar talaba test topshirayotganda brauzer oynasini yashirish, boshqa sahifaga (tab-switch) o‘tish yoki to‘liq ekran rejimidan chiqish harakatlarini qayd etadi, ogohlantirish beradi va serverga kiber-insident xabarini yuboradi.",
    "mathscore-student/src/App.jsx & server.js",
`// Frontend: Talaba harakatlarini kuzatish (Proctoring Event Listeners)
useEffect(() => {
  if (examActive) {
    const handleVisibilityChange = () => {
      if (document.hidden) {
        setTabSwitches(prev => {
          const updated = prev + 1;
          // Shubhali harakat haqida serverga xabar berish
          fetch('/api/system/cheat-report', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': \`Bearer \${token}\`
            },
            body: JSON.stringify({
              testId: currentTest.id,
              type: 'TAB_SWITCH',
              timestamp: new Date().toISOString(),
              switchCount: updated
            })
          });
          alert(\`OGOHLANTIRISH: Siz test sahifasini tark etdingiz! Qoidabuzarliklar soni: \${updated}\`);
          return updated;
        });
      }
    };

    document.addEventListener('visibilitychange', handleVisibilityChange);
    return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
  }
}, [examActive, currentTest]);

// Backend: Anti-cheat hodisasini qayd etish
app.post('/api/system/cheat-report', authenticateToken, async (req, res) => {
  const { testId, type, switchCount } = req.body;
  await db.logSecurityIncident({
    type: 'EXAM_CHEAT_ATTEMPT',
    severity: switchCount > 3 ? 'HIGH' : 'LOW',
    message: \`Talaba (\${req.user.email}) test (\${testId}) paytida oynani \${switchCount} marta almashtirdi.\`,
    ip: req.ip || 'unknown'
  });
  res.json({ status: 'recorded' });
});`
  );

  // -------------------------------------------------------------
