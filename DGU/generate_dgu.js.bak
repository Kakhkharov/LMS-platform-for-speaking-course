  addSection(
    "10. O‘quvchilar uchun integratsiyalashgan Desmos grafik kalkulyatori moduli",
    "Ushbu modul talabalarga murakkab matematik funksiyalar (kvadratik, trigonometrik, ko‘rsatkichli, hosila va integrallar) grafiklarini hisoblash va tahlil qilish imkonini beruvchi Desmos API interfeysidir.",
    "mathscore-student/src/DesmosCalculator.jsx",
`export default function DesmosCalculator({ isOpen, onClose, viewMode = 'floating' }) {
  if (!isOpen) return null;

  // A/AS-Level matematika kursi uchun formulalar to'plami
  const mathPresets = [
    { name: 'Kvadratik funksiya', formula: 'y = a*x^2 + b*x + c', desc: 'Parabola va uning simmetriya o\\'qi' },
    { name: 'Trigonometrik to\\'lqin', formula: 'y = a*sin(b*x - c) + d', desc: 'Amplituda, davr va fazalar' },
    { name: 'Ko\\'rsatkichli funksiya', formula: 'y = a*e^(k*x)', desc: 'O\\'sish va so\\'nish jarayonlari' },
    { name: 'Doira tenglamasi', formula: '(x - h)^2 + (y - k)^2 = r^2', desc: 'Markaz (h, k) va radius r' },
    { name: 'Hosila chizig\\'i', formula: 'f(x) = x^3 - 3x; g(x) = f\\'(x)', desc: 'Ekstremum nuqtalarini topish' }
  ];

  return (
    <div className="desmos-calculator-container shadow-2xl rounded-2xl bg-white border border-slate-200">
      <div className="calc-header flex justify-between items-center p-3 bg-slate-900 text-white rounded-t-2xl">
        <span className="font-semibold text-sm">Desmos Matematik Grafik Kalkulyatori</span>
        <button onClick={onClose} className="p-1 hover:bg-slate-700 rounded-lg">✕</button>
      </div>
      <iframe
        src="https://www.desmos.com/calculator"
        title="Desmos Graphing Calculator"
        className="w-full h-[500px] border-none"
      />
    </div>
  );
}`
  );

  // -------------------------------------------------------------
  // BO'LIM 11: TOPSHIRIQLAR (UY VAZIFALARI) VA FAYLLAR YUKLASH
  // -------------------------------------------------------------
  addSection(
    "11. Uy vazifalari (topshiriqlar), yozma ishlarni topshirish va qayta tekshirish moduli",
    "Ushbu modul talabaning mustaqil bajargan yozma ishlari (PDF, DOCX, fotosuratlar)ni yuklash, o‘qituvchi tomonidan tekshirilib baholanishi va zarur bo‘lganda qayta topshirishga ruxsat berish oqimini boshqaradi.",
    "server.js",
`// Talaba tomonidan yozma ishni yuklash va topshirish
app.post('/api/tasks/:id/submit', upload.single('file'), async (req, res) => {
  const taskId = req.params.id;
  const { studentNotes } = req.body;
  const file = req.file;

  const task = await db.getById('tasks', taskId);
  if (!task) return res.status(404).json({ error: 'Topshiriq topilmadi.' });

  const updatedSubmissions = task.submissions || [];
  updatedSubmissions.push({
    userId: req.user.id,
    userName: req.user.name,
    fileUrl: file ? \`/uploads/\${file.filename}\` : null,
    fileName: file ? file.originalname : null,
    studentNotes: studentNotes || '',
    status: 'Tekshirilmoqda',
    submittedAt: new Date().toISOString()
  });

  await db.update('tasks', taskId, { submissions: updatedSubmissions });
  res.json({ success: true, message: 'Yozma ish muvaffaqiyatli topshirildi!' });
});

// O'qituvchi tomonidan baholash
app.post('/api/tasks/:id/grade', authenticateToken, requireRole('admin'), async (req, res) => {
  const taskId = req.params.id;
  const { userId, score, feedback } = req.body;

  const task = await db.getById('tasks', taskId);
  if (!task) return res.status(404).json({ error: 'Topshiriq topilmadi.' });

  const submissions = (task.submissions || []).map(sub => {
    if (sub.userId === userId) {
      return {
        ...sub,
        score: Number(score),
        feedback: feedback || '',
        status: 'Baholandi',
        gradedAt: new Date().toISOString()
      };
    }
    return sub;
  });

  await db.update('tasks', taskId, { submissions });
  res.json({ success: true, message: 'Topshiriq baholandi!' });
});

// Qayta topshirishga ruxsat berish
app.post('/api/tasks/:id/allow-resubmit', authenticateToken, requireRole('admin'), async (req, res) => {
  const taskId = req.params.id;
  const { userId } = req.body;

  const task = await db.getById('tasks', taskId);
  if (!task) return res.status(404).json({ error: 'Topshiriq topilmadi.' });

  const submissions = (task.submissions || []).filter(sub => sub.userId !== userId);
  await db.update('tasks', taskId, { submissions });

  res.json({ success: true, message: 'O\\'quvchiga qayta topshirish huquqi berildi.' });
});`
  );

  // -------------------------------------------------------------
  // BO'LIM 12: MA'LUMOTLAR BAZASI RELYATSION TUZILMASI
  // -------------------------------------------------------------
  addSection(
    "12. Ma’lumotlar bazasi reliesion modeli va sxemasi (Data Schema)",
    "Ushbu model «MathScore» tizimidagi barcha obyektlar (foydalanuvchilar, kurslar, video darsliklar, testlar, savollar, yechimlar, proktoring va audit jurnallari) relyatsion munosabatlarini belgilaydi.",
    "prisma/schema.prisma",
`datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            String         @default("student")
  avatar          String?
  phone           String?
  status          String?        @default("Online")
  deadline        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  submissions     Submission[]
  userCourses     UserCourse[]
  notifications   Notification[]
  completedLessons CompletedLesson[]
}

model Course {
  id          String       @id @default(uuid())
  title       String
  category    String
  instructor  String
  price       String
  image       String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lessons     Lesson[]
  tests       Test[]
  userCourses UserCourse[]
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  duration    String
  videoUrl    String
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedBy CompletedLesson[]
}

model Test {
  id                 String       @id @default(uuid())
  title              String
  category           String
  difficulty         String
  questionCount      Int
  duration           Int          // daqiqalarda
  status             String
  passingPercentage  Int?         @default(70)
  courseId           String?
  course             Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions          Question[]
  submissions        Submission[]
  createdAt          DateTime     @default(now())
}

model Question {
  id            String  @id @default(uuid())
  type          String  // single, multiple, truefalse, short, math
  text          String
  options       String  // JSON formatida
  correctAnswer String  // JSON yoki matn
  score         Int
  markingScheme String? // AI baholash mezoni
  testId        String
  test          Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Submission {
  id             String   @id @default(uuid())
  userId         String
  testId         String
  score          Int
  correctCount   Int
  incorrectCount Int
  tabSwitches    Int      @default(0)
  timeSpent      String?  
  passed         Boolean
  details        String?  // Savollar tahlili va AI xulosasi
  submittedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id        String   @id @default(uuid())
  type      String
  severity  String
  message   String
  ip        String
  details   String?
  timestamp DateTime @default(now())
}`
  );

  return new Document({
    sections: [{
      properties: {
        page: {
          margin: {
            top: 1440,
            right: 1440,
            bottom: 1440,
            left: 1440
          }
        }
      },
      children: children
    }]
  });
}

// Generate and save
async function main() {
  const doc = buildMathscoreDguDocument();
  const buffer = await Packer.toBuffer(doc);
  
  const targetDir1 = 'D:/My site/Malika opa/DGU';
  const targetDir2 = 'D:/My site/Malika opa';
  
  const file1 = path.join(targetDir1, 'DGU_mathscore.docx');
  const file2 = path.join(targetDir2, 'DGU_mathscore.docx');

  fs.writeFileSync(file1, buffer);
  fs.writeFileSync(file2, buffer);

  console.log('Successfully generated DGU_mathscore.docx in:');
  console.log(' - ' + file1 + ' (' + buffer.length + ' bytes)');
  console.log(' - ' + file2 + ' (' + buffer.length + ' bytes)');
}

main().catch(err => {
  console.error('Error generating docx:', err);
});
