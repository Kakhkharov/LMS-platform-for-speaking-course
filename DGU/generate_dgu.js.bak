    null,
    null
  );

  // -------------------------------------------------------------
  // BO'LIM 2: XAVFSIZLIK VA AUDIT JURNALI
  // -------------------------------------------------------------
  addSection(
    "2. Tizim xavfsizligi, kiberxurujlardan himoyalanish (XSS, Brute-force, CORS) va audit jurnali",
    "Ushbu funksiyalar tizimni ruxsatsiz kirishlardan, Brute-force parollarni tanlash xurujlaridan, DoS/DDoS so‘rovlar oqimidan va XSS inyeksiyalaridan ishonchli himoya qilish hamda har bir shubhali harakatni audit jurnalida qayd etish uchun xizmat qiladi.",
    "security.js",
`const jwt = require('jsonwebtoken');
const rateLimit = require('express-rate-limit');
const db = require('./db');

const JWT_SECRET = process.env.JWT_SECRET || 'mathscore-super-secure-secret-key-2026';

// CORS xavfsizlik konfiguratsiyasi
const corsOptions = {
  origin: function (origin, callback) {
    const allowedOrigins = [
      'https://mathscore.uz',
      'https://api.mathscore.uz',
      'http://localhost:5173',
      'http://localhost:5174',
      'http://localhost:5175'
    ];
    if (!origin || allowedOrigins.indexOf(origin) !== -1) {
      callback(null, true);
    } else {
      db.logSecurityIncident({
        type: 'CORS_BLOCKED',
        severity: 'MEDIUM',
        message: \`Ruxsat etilmagan domendan so'rov bloklandi: \${origin}\`,
        ip: 'unknown'
      });
      callback(new Error('Blocked by CORS policy'));
    }
  },
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization']
};

// Global rate limiting - DDoS va brute-force xurujlariga qarshi
const globalRateLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 daqiqa
  max: 200, // Bitta IP dan ko'pi bilan 200 ta so'rov
  standardHeaders: true,
  legacyHeaders: false,
  message: { error: 'Juda ko\\'p so\\'rov yuborildi. Iltimos keyinroq qayta urinib ko\\'ring.' },
  handler: (req, res, next, options) => {
    db.logSecurityIncident({
      type: 'RATE_LIMIT_EXCEEDED',
      severity: 'HIGH',
      message: \`Global rate limit oshirildi: \${req.path}\`,
      ip: req.ip || req.headers['x-forwarded-for'] || 'unknown'
    });
    res.status(429).json(options.message);
  }
});

// Autentifikatsiya (Login/Register) uchun qat'iy cheklov
const authRateLimiter = rateLimit({
  windowMs: 10 * 60 * 1000, // 10 daqiqa
  max: 10, // Ko'pi bilan 10 ta urinish
  message: { error: 'Kirish urinishlari ko\\'payib ketdi. 10 daqiqa kuting.' },
  handler: (req, res, next, options) => {
    db.logSecurityIncident({
      type: 'BRUTE_FORCE_SUSPICION',
      severity: 'CRITICAL',
      message: 'Ketma-ket muvaffaqiyatsiz login urinishlari aniqlandi',
      ip: req.ip || req.headers['x-forwarded-for'] || 'unknown',
      details: { email: req.body?.email }
    });
    res.status(429).json(options.message);
  }
});

// XSS xurujlarini aniqlash va zararsizlantirish
function sanitizeInput(req, res, next) {
  const sanitize = (val) => {
    if (typeof val === 'string') {
      const xssPattern = /<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>|javascript:|onerror=|onload=|onclick=/gi;
      if (xssPattern.test(val)) {
        db.logSecurityIncident({
          type: 'XSS_ATTEMPT_DETECTED',
          severity: 'HIGH',
          message: \`XSS xuruji aniqlandi va bloklandi: \${val.substring(0, 100)}\`,
          ip: req.ip || req.headers['x-forwarded-for'] || 'unknown'
        });
        throw new Error('Xavfli belgi aniqlandi! Input bloklandi.');
      }
      return val.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    return val;
  };
  if (req.body) {
    for (let key in req.body) req.body[key] = sanitize(req.body[key]);
  }
  next();
}`
  );

  // -------------------------------------------------------------
  // BO'LIM 3: AUTENTIFIKATSIYA VA ROLLARI BO'YICHA VAKOLAT
  // -------------------------------------------------------------
  addSection(
    "3. Foydalanuvchilarni ro‘yxatdan o‘tkazish, autentifikatsiya va JWT sessiya nazorati",
    "Ushbu funksiyalar foydalanuvchilarning hisob qaydnomasini ro‘yxatdan o‘tkazish, parollarni xesh-tekshirish (Bcrypt), JWT (JSON Web Token) yaratish, token validatsiyasi va foydalanuvchi roli (admin yoki student) bo‘yicha tizim huquqlarini tekshirishni amalga oshiradi.",
    "server.js & security.js",
`// JWT Tokenni tekshirish oraliq dasturi (Middleware)
function authenticateToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Avtorizatsiya talab qilinadi (Token yo\\'q).' });

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) return res.status(403).json({ error: 'Yaroqsiz yoki muddati o\\'tgan token.' });
    req.user = user;
    next();
  });
}

// Foydalanuvchi roliga muvofiqlikni tekshirish
function requireRole(role) {
  return (req, res, next) => {
    if (!req.user || req.user.role !== role) {
      db.logSecurityIncident({
        type: 'UNAUTHORIZED_ACCESS_ATTEMPT',
        severity: 'MEDIUM',
        message: \`Foydalanuvchi (\${req.user?.email}) ruxsatsiz yo'nalishga (\${req.path}) kirishga urindi.\`,
        ip: req.ip || 'unknown'
      });
      return res.status(403).json({ error: 'Ushbu amalni bajarish uchun sizda yetarli huquq yo\\'q.' });
    }
    next();
  };
}

// Foydalanuvchini ro'yxatdan o'tkazish funksiyasi
app.post('/api/auth/register', authRateLimiter, async (req, res) => {
  const { name, email, password, phone } = req.body;
  if (!name || !email || !password) {
    return res.status(400).json({ error: 'Barcha maydonlarni to\\'ldiring.' });
  }

  const existingUser = await db.getUserByEmail(email);
  if (existingUser) {
    return res.status(400).json({ error: 'Ushbu elektron pochta bilan foydalanuvchi mavjud.' });
  }

  const hashedPassword = await bcrypt.hash(password, 10);
  const newUser = await db.create('users', {
    name,
    email,
    password: hashedPassword,
    role: 'student',
    phone: phone || '',
    status: 'Online',
    createdAt: new Date().toISOString()
  });

  const token = jwt.sign(
    { id: newUser.id, email: newUser.email, role: newUser.role, name: newUser.name },
    JWT_SECRET,
    { expiresIn: '7d' }
  );

  res.status(201).json({ token, user: { id: newUser.id, name: newUser.name, email: newUser.email, role: newUser.role } });
});

// Tizimga kirish (Login) funksiyasi
app.post('/api/auth/login', authRateLimiter, async (req, res) => {
  const { email, password } = req.body;
  const user = await db.getUserByEmail(email);
  if (!user) return res.status(400).json({ error: 'Elektron pochta yoki parol noto\\'g\\'ri.' });

  const validPassword = await bcrypt.compare(password, user.password);
  if (!validPassword) {
    return res.status(400).json({ error: 'Elektron pochta yoki parol noto\\'g\\'ri.' });
  }

  const token = jwt.sign(
    { id: user.id, email: user.email, role: user.role, name: user.name },
    JWT_SECRET,
    { expiresIn: '7d' }
  );

  await db.update('users', user.id, { status: 'Online' });
  res.json({ token, user: { id: user.id, name: user.name, email: user.email, role: user.role } });
});`
  );

  // -------------------------------------------------------------
  // BO'LIM 4: KURSLAR VA VIDEO DARSLIKLAR BOSHQARUVI
  // -------------------------------------------------------------
  addSection(
    "4. Matematika kurslari, video darsliklar va o‘quvchi progressini boshqarish moduli",
    "Ushbu funksiyalar matematika kurslarini shakllantirish, video darsliklarni tartib bilan yuklash hamda talabaning har bir dars bo‘yicha o‘zlashtirishini (CompletedLesson) qayd etishni ta’minlaydi.",
    "server.js",
`// Barcha kurslarni olish
app.get('/api/courses', async (req, res) => {
  const courses = await db.get('courses');
  res.json(courses || []);
});

// Yangi matematika kursi yaratish (Faqat Administrator uchun)
app.post('/api/courses', authenticateToken, requireRole('admin'), async (req, res) => {
  const { title, category, instructor, price, image, description, lessons } = req.body;
  if (!title || !category) {
    return res.status(400).json({ error: 'Kurs nomi va toifasi kiritilishi shart.' });
